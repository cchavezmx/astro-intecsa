---
import Layout from '../layouts/Layout.astro';
import AnimatedSection from '../components/AnimatedSection.astro';
import Container from '../components/Container.astro';

const catalogs = [
  {
    title: 'Resumen de Obras',
    description: 'Portafolio completo de proyectos ejecutados para retail, cines, centros comerciales y naves industriales.',
    action: 'Descargar PDF',
    href: '/CV_INTECSA.pdf',
    download: true,
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  },
  {
    title: 'Certificado ABB 2025',
    description: 'Certificación oficial como PanelBuilder por ABB. Validez a partir del 17 de julio de 2025.',
    action: 'Ver certificado',
    href: '/certificado_abb_2025.pdf',
    download: false,
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Memoria Fotográfica',
    description: 'Imágenes de centros de control de motores, tableros generales, subestaciones transformadoras y canalizaciones.',
    action: 'Ver galería',
    href: '/about',
    download: false,
    icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  },
];

const products = [
  {
    title: 'Tableros de Distribución',
    description: 'Fabricación e integración de tableros de baja tensión con tecnología ABB certificada.',
    icon: '⚡',
  },
  {
    title: 'Centros de Control de Motores',
    description: 'Diseño y montaje de CCM para instalaciones industriales y comerciales de alta demanda.',
    icon: '🔌',
  },
  {
    title: 'Canalizaciones Eléctricas',
    description: 'Canalización en media y baja tensión, soportería metálica y registros especiales.',
    icon: '🔧',
  },
  {
    title: 'Subestaciones y Transformadores',
    description: 'Instalación de subestaciones móviles, transformadores y equipos de distribución.',
    icon: '🏭',
  },
  {
    title: 'Sistemas Especiales',
    description: 'Pararrayos, filtros de armónicos, analizadores de red y equipos contra incendios.',
    icon: '🛡️',
  },
  {
    title: 'Renta de Equipos',
    description: 'Generadores, luminarias, torres, andamios y equipos para instalaciones provisionales.',
    icon: '🚧',
  },
];
---

<Layout title="Catálogos y Documentos | Instalaciones y Técnica">
  <div class="bg-light min-h-screen pb-20">
    <!-- Hero interno -->
    <section class="relative py-20 md:py-28 overflow-hidden gradient-corporate">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-corporate/20 to-corporate/90"></div>
      <Container class="relative z-10">
        <AnimatedSection class="text-center max-w-3xl mx-auto">
          <p class="text-intecsa-orange-light font-semibold text-sm uppercase tracking-widest mb-4">Recursos</p>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-white mb-6">
            Catálogos y <span class="text-intecsa-orange-light">documentos</span>
          </h1>
          <p class="text-lg text-white/90">
            Descarga documentos oficiales, certificaciones y consulta nuestros productos y servicios.
          </p>
        </AnimatedSection>
      </Container>
    </section>

    <!-- Documentos -->
    <section class="py-12 bg-soft">
      <Container>
        <div class="grid md:grid-cols-3 gap-6">
          {catalogs.map((catalog, index) => (
            <AnimatedSection delay={index * 100}>
              <div class="card-corporate rounded-2xl p-8 h-full flex flex-col">
                <div class="w-14 h-14 rounded-2xl bg-corporate/10 flex items-center justify-center mb-6">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-corporate" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={catalog.icon} />
                  </svg>
                </div>
                <h2 class="text-xl font-bold text-intecsa-gray-dark mb-3">{catalog.title}</h2>
                <p class="text-intecsa-slate text-sm leading-relaxed mb-6 flex-grow">{catalog.description}</p>
                <a
                  href={catalog.href}
                  target="_blank"
                  rel={catalog.download ? undefined : 'noopener noreferrer'}
                  download={catalog.download ? '' : undefined}
                  class="btn-outline w-full justify-center"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  {catalog.action}
                </a>
              </div>
            </AnimatedSection>
          ))}
        </div>
      </Container>
    </section>

    <!-- Productos -->
    <section class="py-20 bg-light">
      <Container>
        <AnimatedSection class="text-center max-w-3xl mx-auto mb-12">
          <p class="text-corporate font-semibold text-sm uppercase tracking-widest mb-3">Líneas de negocio</p>
          <div class="corporate-line mx-auto mb-5"></div>
          <h2 class="text-3xl sm:text-4xl font-bold text-intecsa-gray-dark mb-4">Nuestros productos</h2>
          <p class="text-intecsa-slate">
            Soluciones eléctricas diseñadas y fabricadas bajo los más altos estándares de calidad.
          </p>
        </AnimatedSection>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {products.map((product, index) => (
            <AnimatedSection delay={index * 80}>
              <div class="card-corporate rounded-2xl p-6 h-full">
                <div class="w-12 h-12 rounded-xl bg-corporate/10 flex items-center justify-center mb-4">
                  <span class="text-2xl">{product.icon}</span>
                </div>
                <h3 class="text-xl font-bold text-intecsa-gray-dark mb-3">{product.title}</h3>
                <p class="text-intecsa-slate text-sm leading-relaxed">{product.description}</p>
              </div>
            </AnimatedSection>
          ))}
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <section class="py-12 px-4 bg-soft">
      <Container>
        <AnimatedSection>
          <div class="card-corporate rounded-3xl p-8 md:p-12 text-center">
            <h2 class="text-2xl md:text-3xl font-bold text-intecsa-gray-dark mb-4">
              ¿Necesitas una cotización personalizada?
            </h2>
            <p class="text-intecsa-slate mb-8 max-w-2xl mx-auto">
              Cuéntanos sobre tu proyecto y nuestro equipo te contactará para una propuesta a la medida.
            </p>
            <a
              href="https://forms.monday.com/forms/embed/608067760034e1ac1f86e10392668e8b?r=use1"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-corporate"
            >
              Solicitar cotización
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </AnimatedSection>
      </Container>
    </section>
  </div>
</Layout>
