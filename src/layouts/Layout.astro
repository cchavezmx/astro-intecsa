---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const { title = "Grupo Intecsa" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Grupo Intecsa — Instalaciones y Técnica S.A. de C.V. Empresa mexicana con más de 27 años de experiencia en integraciones ABB, instalaciones eléctricas industriales y comerciales. Obras realizadas para Liverpool, Palacio de Hierro, Grupo Inditex y CFE en México."
    />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-gray-900 antialiased">
    <!-- Navbar -->
    <nav class="sticky top-0 z-50 bg-white/[0.86] backdrop-blur-md border-b border-[#e8eaee]">
      <div class="max-w-[1200px] mx-auto px-6 h-[74px] flex items-center justify-between gap-6">
        <a href="/" class="flex items-center gap-3 text-inherit">
          <img
            src="https://blog-omega-mauve.vercel.app/_next/image?url=%2Flogo%2Fweb-logo.webp&w=96&q=75"
            alt="Logo Grupo Intecsa"
            class="h-10 w-auto object-contain block"
          />
          <span class="text-[17px] font-extrabold tracking-[0.06em] text-gray-900 uppercase">
            Grupo <span class="text-brand-600">Intecsa</span>
          </span>
        </a>

        <div class="flex items-center gap-7">
          <a
            href="https://forms.monday.com/forms/embed/608067760034e1ac1f86e10392668e8b?r=use1"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-brand"
          >
            Contacto
            <img src="/icons/contacto.svg" alt="" class="h-4 w-4 brightness-0 invert" />
          </a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <Footer />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Grupo Intecsa — Instalaciones y Técnica, S.A. de C.V.",
        "url": "https://itamx.com",
        "alternateName": "Instalaciones y Técnica S.A. de C.V.",
        "logo": "https://blog-omega-mauve.vercel.app/_next/image?url=%2Flogo%2Fweb-logo.webp&w=96&q=75",
        "description": "Partner oficial de ABB, integraciones eléctricas para Liverpool, Palacio de Hierro, Grupo Inditex y CFE en México.",
        "sameAs": [
          "https://www.linkedin.com/company/grupo-intecsa/",
          "https://www.facebook.com/people/Grupo-Intecsa-Mx-Oficial"
        ],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Ciudad de México",
          "addressCountry": "MX",
          "addressRegion": "CDMX",
          "postalCode": "01220",
          "streetAddress": "Raúl Zárate Machuca Cuevítas, 01220 Ciudad de México, CDMX"
        }
      }
    </script>
  </body>
</html>
