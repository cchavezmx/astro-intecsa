---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/about' },
  { label: 'Catálogos', href: '/products' },
];

const legalLinks = [
  { label: 'Política de Privacidad', href: '/politica-privacidad' },
  { label: 'Términos de Servicio', href: '/terminos-servicio' },
  { label: 'Aviso Legal', href: '/aviso-legal' },
  { label: 'Código de Conducta', href: '/codigo-conducta' },
];
---

<footer class="bg-slate-950 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <!-- Logo y descripción -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-5">
          <img
            src="https://blog-omega-mauve.vercel.app/_next/image?url=%2Flogo%2Fweb-logo.webp&w=96&q=75"
            alt="Logo Instalaciones y Técnica"
            class="h-10 w-auto object-contain"
          />
          <span class="text-xl font-bold tracking-tight">
            Instalaciones <span class="text-electric">y Técnica</span>
          </span>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Especialistas en instalación, planeación, construcción y mantenimiento de centros comerciales, naves industriales y edificios inteligentes.
        </p>
        <div class="flex space-x-4">
          <a
            href="https://www.linkedin.com/company/grupo-intecsa/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-slate-900 border border-white/10 flex items-center justify-center text-slate-400 hover:text-electric hover:border-electric/30 transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
          <a
            href="https://www.facebook.com/people/Grupo-Intecsa-Mx-Oficial"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-slate-900 border border-white/10 flex items-center justify-center text-slate-400 hover:text-electric hover:border-electric/30 transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Enlaces rápidos -->
      <div>
        <h3 class="text-white font-semibold mb-5">Enlaces rápidos</h3>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-slate-400 hover:text-electric transition-colors text-sm">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-white font-semibold mb-5">Contacto</h3>
        <address class="not-italic space-y-3 text-sm text-slate-400">
          <p>Raúl Zárate Machuca Cuevítas #11<br />01220 Ciudad de México, CDMX</p>
          <p>
            <a href="mailto:contacto@grupointecsa.com" class="hover:text-electric transition-colors">contacto@grupointecsa.com</a>
          </p>
          <p>Lunes a Viernes: 9:00 - 18:00</p>
        </address>
      </div>

      <!-- Mapa -->
      <div>
        <h3 class="text-white font-semibold mb-5">Ubicación</h3>
        <div class="rounded-xl overflow-hidden border border-white/10">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5322.527002406184!2d-99.22696839255828!3d19.38668419189787!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85d201adefab9513%3A0xa5936acc13a69c0d!2sRa%C3%BAl%20Z%C3%A1rate%20Machuca%2011%2C%20Cuevitas%2C%20%C3%81lvaro%20Obreg%C3%B3n%2C%2001220%20Ciudad%20de%20M%C3%A9xico%2C%20CDMX!5e0!3m2!1ses!2smx!4v1613650539398!5m2!1ses!2smx"
            width="100%"
            height="160"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            class="grayscale hover:grayscale-0 transition-all duration-500"
            aria-label="Mapa de ubicación de Instalaciones y Técnica"
          ></iframe>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm text-slate-500">
          © {currentYear} Instalaciones y Técnica S.A. de C.V. Todos los derechos reservados.
        </p>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2">
          {legalLinks.map((link) => (
            <a href={link.href} class="text-sm text-slate-500 hover:text-electric transition-colors">{link.label}</a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
