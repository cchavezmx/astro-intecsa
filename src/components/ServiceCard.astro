---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div class="group card-corporate p-6 h-full">
  <div class="w-14 h-14 rounded-xl bg-corporate/10 flex items-center justify-center mb-5 group-hover:bg-corporate group-hover:scale-110 transition-all duration-300">
    <span class="text-2xl group-hover:text-white transition-colors">{icon}</span>
  </div>
  <h3 class="text-xl font-bold text-intecsa-gray-dark mb-3">{title}</h3>
  <p class="text-intecsa-gray text-sm leading-relaxed">{description}</p>
</div>
