---
const brands = [
  'Liverpool',
  'El Palacio de Hierro',
  'ABB',
  'CFE',
  'Cinemex',
  'ITX Retail',
  'Pull & Bear',
  'Bershka',
  'Stradivarius',
  'Oysho',
  'Zara',
  'Massimo Dutti',
];
---

<section class="py-10 border-y border-white/10 bg-slate-900/50 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
    <p class="text-center text-sm font-medium text-slate-400 uppercase tracking-widest">
      Confían en nosotros
    </p>
  </div>

  <div class="relative">
    <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-slate-950 to-transparent z-10"></div>
    <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-slate-950 to-transparent z-10"></div>

    <div class="flex animate-marquee whitespace-nowrap">
      {
        [...brands, ...brands].map((brand) => (
          <div class="inline-flex items-center mx-8 px-6 py-3 rounded-full glass-card text-slate-300 font-semibold text-sm hover:text-electric hover:border-electric/30 transition-colors">
            {brand}
          </div>
        ))
      }
    </div>
  </div>
</section>
