---
const certs_images = [
  "foto_029310.png",
  "foto_047750.png",
  "foto_049490.png",
  "foto_087795.png",
  "foto_132900.png",
  "foto_160191.png",
  "foto_165181.png",
  "foto_195714.png",
  "foto_276618.png",
  "foto_310533.png",
  "foto_328897.png",
  "foto_374552.png",
  "foto_375562.png",
  "foto_445737.png",
  "foto_456455.png",
  "foto_465687.png",
  "foto_468111.png",
  "foto_472939.png",
  "foto_493603.png",
  "foto_517219.png",
  "foto_580050.png",
  "foto_605238.png",
  "foto_606979.png",
  "foto_612531.png",
  "foto_676879.png",
  "foto_705338.png",
  "foto_713344.png",
  "foto_741342.png",
  "foto_763482.png",
  "foto_765961.png",
  "foto_783795.png",
  "foto_803571.png",
  "foto_813475.png",
  "foto_834448.png",
  "foto_934135.png",
  "foto_962474.png",
  "foto_025399.png",
];
---

<div class="cert-gallery-wrapper" data-gallery="true">
  <div class="cert-trigger cursor-pointer">
    <slot />
  </div>

  <div class="cert-modal hidden fixed inset-0 z-[100]">
    <div class="fixed inset-0 bg-slate-950/95 backdrop-blur-sm" data-modal-backdrop></div>

    <div class="relative z-10 flex items-center justify-center min-h-screen p-4">
      <div class="bg-slate-900 rounded-2xl w-full max-w-6xl mx-auto border border-white/10 shadow-2xl overflow-hidden">
        <button
          type="button"
          class="cert-close absolute top-4 right-4 z-20 bg-slate-800/80 hover:bg-slate-700 text-white p-2 rounded-full transition-colors"
          aria-label="Cerrar galería"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        <div class="flex flex-col lg:flex-row">
          <div class="w-full lg:w-3/4 bg-black/50">
            <div class="relative pt-[75%] lg:pt-[56.25%]">
              <img
                data-cert-image
                src={`certs/${certs_images[0]}`}
                alt="Certificado seleccionado"
                class="absolute top-0 left-0 w-full h-full object-contain"
              />
            </div>
          </div>

          <div class="w-full lg:w-1/4 p-6 bg-slate-800/50 flex flex-col justify-between">
            <div>
              <h2 class="text-2xl font-bold text-white mb-2">Certificaciones</h2>
              <p class="text-slate-400 text-sm mb-6">
                Galería de certificados y reconocimientos obtenidos a lo largo de nuestra trayectoria.
              </p>
              <div class="text-sm text-slate-500 mb-4">
                <span data-cert-counter>1</span> / {certs_images.length}
              </div>
            </div>

            <div class="flex gap-2 justify-between mt-auto">
              <button
                type="button"
                class="cert-prev flex-1 bg-slate-700 hover:bg-slate-600 text-white px-4 py-2.5 rounded-lg transition-colors text-sm font-medium"
              >
                Anterior
              </button>
              <button
                type="button"
                class="cert-next flex-1 bg-electric hover:bg-electric-dark text-slate-950 px-4 py-2.5 rounded-lg transition-colors text-sm font-medium font-semibold"
              >
                Siguiente
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const wrappers = document.querySelectorAll('[data-gallery="true"]');

    wrappers.forEach((wrapper) => {
      const trigger = wrapper.querySelector('.cert-trigger');
      const modal = wrapper.querySelector('.cert-modal');
      const closeBtn = wrapper.querySelector('.cert-close');
      const backdrop = wrapper.querySelector('[data-modal-backdrop]');
      const nextBtn = wrapper.querySelector('.cert-next');
      const prevBtn = wrapper.querySelector('.cert-prev');
      const img = wrapper.querySelector('[data-cert-image]');
      const counter = wrapper.querySelector('[data-cert-counter]');

      if (!trigger || !modal || !img) return;

      const certs_images = [
        "foto_029310.png", "foto_047750.png", "foto_049490.png", "foto_087795.png",
        "foto_132900.png", "foto_160191.png", "foto_165181.png", "foto_195714.png",
        "foto_276618.png", "foto_310533.png", "foto_328897.png", "foto_374552.png",
        "foto_375562.png", "foto_445737.png", "foto_456455.png", "foto_465687.png",
        "foto_468111.png", "foto_472939.png", "foto_493603.png", "foto_517219.png",
        "foto_580050.png", "foto_605238.png", "foto_606979.png", "foto_612531.png",
        "foto_676879.png", "foto_705338.png", "foto_713344.png", "foto_741342.png",
        "foto_763482.png", "foto_765961.png", "foto_783795.png", "foto_803571.png",
        "foto_813475.png", "foto_834448.png", "foto_934135.png", "foto_962474.png",
        "foto_025399.png",
      ];

      let current = 0;
      const total = certs_images.length;

      function updateImage() {
        img.src = `certs/${certs_images[current]}`;
        if (counter) counter.textContent = String(current + 1);
      }

      function open() {
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        current = 0;
        updateImage();
      }

      function close() {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }

      function next() {
        current = (current + 1) % total;
        updateImage();
      }

      function prev() {
        current = (current - 1 + total) % total;
        updateImage();
      }

      trigger.addEventListener('click', open);
      closeBtn?.addEventListener('click', close);
      backdrop?.addEventListener('click', close);
      nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); next(); });
      prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); prev(); });

      document.addEventListener('keydown', (e) => {
        if (modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowRight') next();
        if (e.key === 'ArrowLeft') prev();
      });
    });
  })();
</script>
