---
import CertsGallery from '../components/Certifications.astro';

const projects = [
  {
    image: '/assets/santa_anita_liverpool.webp',
    date: '2021-07-08',
    title: 'Guadalajara, Liverpool',
    description: 'Se trata de un proyecto de iluminación y control de energía eléctrica en el centro comercial Liverpool.',
  },
  {
    image: '/assets/liverpool_gourmet.webp',
    date: '2020-03-16',
    title: 'Liverpool Gourmet Polanco CDMX, 2024',
    description: 'Se trata de un tablero inteligente que permite la gestión de la energía eléctrica de manera eficiente y segura.',
  },
];
---

<div class="bg-white">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-950 min-h-[560px] flex items-center">
    <div class="absolute inset-0 bg-cover bg-center animate-banner-zoom" style="background-image: url('/assets/hero_ita_min.jpg')"></div>
    <div class="absolute inset-0" style="background: linear-gradient(100deg, rgba(6,14,26,0.9) 0%, rgba(6,14,26,0.72) 45%, rgba(6,14,26,0.25) 100%)"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 py-26 w-full">
      <div class="flex items-center gap-3 mb-6">
        <span class="brand-line"></span>
        <span class="label-mono text-brand-300">Instalaciones y Técnica</span>
      </div>
      <h1 class="m-0 mb-5 max-w-[15ch] text-5xl md:text-6xl lg:text-[64px] leading-[1.02] tracking-[-0.035em] font-extrabold text-white [text-wrap:balance]">
        Bienvenido a Instalaciones y Técnica
      </h1>
      <p class="m-0 max-w-[56ch] text-lg leading-relaxed text-white/[0.82] [text-wrap:pretty]">
        Somos una empresa dedicada a la fabricación, comercialización y montaje de instalaciones eléctricas en industrias, comercios y edificios.
      </p>
    </div>
  </section>

  <!-- Certificación ABB -->
  <section class="relative overflow-hidden bg-[#0f1c2e] border-t border-brand-400/[0.18]">
    <div class="absolute top-[-30%] right-[-10%] w-[60%] h-[160%] pointer-events-none" style="background: radial-gradient(circle at center, rgba(37,99,235,0.28) 0%, rgba(37,99,235,0) 65%)"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 py-24 grid lg:grid-cols-[1.05fr_0.95fr] gap-16 items-center">
      <div>
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 border border-brand-300/[0.32] rounded-full mb-7">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-400 block"></span>
          <span class="label-mono text-brand-200">ABB · PanelBuilder</span>
        </div>
        <h2 class="m-0 mb-6 text-4xl md:text-[44px] leading-[1.08] tracking-[-0.03em] font-extrabold text-white">
          Certificado Oficial
        </h2>
        <p class="m-0 mb-8 max-w-[54ch] text-lg leading-relaxed text-slate-300/[0.8] [text-wrap:pretty]">
          ABB certifica a <strong class="text-white font-bold">Instalaciones y Técnica</strong> como <strong class="text-white font-bold">PanelBuilder oficial</strong>, reconociendo su profesionalismo, calidad técnica y cumplimiento en soluciones de distribución eléctrica en baja tensión, a partir del <strong class="text-white font-bold">17 de julio de 2025</strong>.
        </p>
        <a href="/certificado_abb_2025.pdf" target="_blank" class="btn-white">
          Ver PDF completo
          <span class="text-[17px] leading-none">→</span>
        </a>
      </div>
      <a href="/certificado_abb_2025.pdf" target="_blank" class="block rounded-2xl overflow-hidden border border-slate-400/[0.28] bg-white/[0.04] p-3.5 shadow-[0_24px_60px_-24px_rgba(0,0,0,0.7)]">
        <img src="/assets/certificado_abb_2025_preview.jpg" alt="Certificado ABB 2025" class="block w-full rounded-lg" />
      </a>
    </div>
  </section>

  <!-- Tarjetas de acceso -->
  <section class="max-w-[1200px] mx-auto px-6 pt-22 pb-2">
    <div class="grid md:grid-cols-3 gap-5">
      <CertsGallery>
        <div class="card-design flex flex-col gap-4 p-7 cursor-pointer h-full">
          <div class="flex items-start justify-between gap-4">
            <h3 class="m-0 text-[22px] tracking-[-0.02em] font-bold text-gray-900">Certificaciones</h3>
            <img src="/icons/certificated.svg" alt="" class="h-[26px] w-auto opacity-85" />
          </div>
          <p class="m-0 text-[15px] leading-relaxed text-gray-600 [text-wrap:pretty]">
            Contamos con certificaciones de calidad otorgadas por ABB, ANCE <strong class="text-gray-900 font-bold">por nuestro cumplimiento y excelencia en instalaciones eléctricas.</strong>
          </p>
          <span class="mt-auto pt-2.5 label-mono text-brand-600">Ver galería →</span>
        </div>
      </CertsGallery>

      <a href="/about" class="card-design flex flex-col gap-4 p-7 text-inherit h-full">
        <div class="flex items-start justify-between gap-4">
          <h3 class="m-0 text-[22px] tracking-[-0.02em] font-bold text-gray-900">Curriculum</h3>
          <img src="/icons/curriculum.svg" alt="" class="h-[26px] w-auto opacity-85" />
        </div>
        <p class="m-0 text-[15px] leading-relaxed text-gray-600 [text-wrap:pretty]">
          Explorá nuestra trayectoria y experiencia en obras para clientes como <strong class="text-gray-900 font-bold">CFE, Inditex, Cinemex y muchos más.</strong>
        </p>
        <span class="mt-auto pt-2.5 label-mono text-brand-600">Nosotros →</span>
      </a>

      <a href="/products" class="card-design flex flex-col gap-4 p-7 text-inherit h-full">
        <div class="flex items-start justify-between gap-4">
          <h3 class="m-0 text-[22px] tracking-[-0.02em] font-bold text-gray-900">Nuestros Catálogos</h3>
          <img src="/icons/package.svg" alt="" class="h-[26px] w-auto opacity-85" />
        </div>
        <p class="m-0 text-[15px] leading-relaxed text-gray-600 [text-wrap:pretty]">
          Descarga nuestros catálogos o revisa nuestros productos en una versión en línea.
        </p>
        <span class="mt-auto pt-2.5 label-mono text-brand-600">Catálogos →</span>
      </a>
    </div>
  </section>

  <!-- Servicios -->
  <section class="py-22">
    <div class="max-w-[1200px] mx-auto px-6">
      <div class="flex items-center gap-3 mb-4">
        <span class="brand-line bg-brand-600"></span>
        <span class="label-mono text-brand-600">Servicios</span>
      </div>
      <h2 class="m-0 mb-10 text-3xl md:text-[40px] leading-[1.08] tracking-[-0.03em] font-extrabold text-gray-900">
        Nuestros Servicios
      </h2>
      <div class="grid md:grid-cols-2 gap-5">
        <div class="p-8 rounded-2xl bg-[#f5f7fa] border border-[#e8eaee] flex flex-col gap-4">
          <div class="flex items-center justify-between gap-5">
            <h3 class="m-0 text-2xl tracking-[-0.02em] font-bold text-gray-900">Partner Oficial ABB</h3>
            <img src="https://campaign.abb.com/l/501021/2019-08-06/q7pxgj/501021/182073/ABB_Logo.png" alt="ABB" class="h-[22px] w-auto" />
          </div>
          <p class="m-0 text-base leading-relaxed text-gray-600 [text-wrap:pretty]">
            Somos integradores certificados por ABB en soluciones eléctricas industriales, automatización y sistemas de distribución. Ofrecemos tecnología de vanguardia con respaldo internacional.
          </p>
        </div>
        <div class="p-8 rounded-2xl bg-[#f5f7fa] border border-[#e8eaee] flex flex-col gap-4">
          <div class="flex items-center justify-between gap-5">
            <h3 class="m-0 text-2xl tracking-[-0.02em] font-bold text-gray-900">Canalización y Soportería</h3>
            <img src="/icons/logito_cana.webp" alt="Canalización" class="h-10 w-auto" />
          </div>
          <p class="m-0 text-base leading-relaxed text-gray-600 [text-wrap:pretty]">
            Diseñamos y ejecutamos canalizaciones eléctricas en media y baja tensión, así como instalación de soportería metálica conforme a norma. Soluciones seguras y eficientes para todo tipo de proyectos.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Proyectos -->
  <section class="max-w-[1200px] mx-auto px-6 pb-24">
    <div class="flex items-center gap-3 mb-4">
      <span class="brand-line bg-brand-600"></span>
      <span class="label-mono text-brand-600">Proyectos</span>
    </div>
    <h2 class="m-0 mb-10 text-3xl md:text-[40px] leading-[1.08] tracking-[-0.03em] font-extrabold text-gray-900">
      Nuestro trabajo
    </h2>
    <div class="grid md:grid-cols-2 gap-5">
      {projects.map((project) => (
        <div class="card-project">
          <img src={project.image} alt={project.title} class="block w-full h-[300px] object-cover" />
          <div class="p-7 flex flex-col gap-3">
            <span class="label-mono text-gray-400">{project.date}</span>
            <h3 class="m-0 text-[22px] tracking-[-0.02em] font-bold text-gray-900">{project.title}</h3>
            <p class="m-0 text-[15px] leading-relaxed text-gray-600 [text-wrap:pretty]">{project.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</div>
