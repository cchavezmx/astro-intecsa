---
import CertsGallery from '../components/Certifications.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import ServiceCard from '../components/ServiceCard.astro';
import AnimatedSection from '../components/AnimatedSection.astro';
import Container from '../components/Container.astro';

const services = [
  {
    title: 'Tableros Eléctricos ABB',
    description: 'Diseño, fabricación e integración de tableros de baja tensión con tecnología ABB certificada.',
    icon: '⚡',
  },
  {
    title: 'Canalización y Soportería',
    description: 'Ejecución de canalizaciones eléctricas en media y baja tensión con soportería metálica conforme a norma.',
    icon: '🔧',
  },
  {
    title: 'Subestaciones y Transformadores',
    description: 'Instalación de subestaciones móviles, transformadores y equipos de distribución eléctrica.',
    icon: '🏭',
  },
  {
    title: 'Renta de Equipos',
    description: 'Generadores, luminarias, torres, andamios y equipos para instalaciones provisionales.',
    icon: '🚧',
  },
  {
    title: 'Sistemas Especiales',
    description: 'Pararrayos, analizadores de red, filtros de armónicos y equipos contra incendios.',
    icon: '🛡️',
  },
  {
    title: 'Mantenimiento Industrial',
    description: 'Servicios de mantenimiento preventivo y correctivo para plantas, centros comerciales y naves.',
    icon: '🔩',
  },
];

const stats = [
  { value: '+27', label: 'Años de experiencia' },
  { value: '+100', label: 'Obras entregadas' },
  { value: '4', label: 'Países de operación' },
  { value: 'ABB', label: 'PanelBuilder certificado' },
];
---

<div class="bg-light">
  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden gradient-corporate">
    <HeroCanvas />
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-corporate/20 to-corporate/90"></div>

    <Container class="relative z-10 py-20">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/15 text-white text-sm font-semibold mb-8 animate-fade-in border border-white/20">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-intecsa-orange opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-intecsa-orange"></span>
          </span>
          PanelBuilder certificado por ABB desde julio 2025
        </div>

        <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight text-white mb-6 animate-fade-in-up" style="animation-delay: 100ms;">
          Bienvenido a <span class="text-intecsa-orange-light">Instalaciones y Técnica</span>
        </h1>

        <p class="text-lg sm:text-xl md:text-2xl text-white/90 max-w-3xl mx-auto mb-10 leading-relaxed animate-fade-in-up" style="animation-delay: 200ms;">
          Más de 27 años fabricando, comercializando y montando instalaciones eléctricas industriales y comerciales en México.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up" style="animation-delay: 300ms;">
          <a href="#servicios" class="btn-corporate bg-white text-corporate hover:bg-gray-100 text-base w-full sm:w-auto">
            Explorar servicios
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
          <a href="/CV_INTECSA.pdf" target="_blank" download class="btn-outline border-white text-white hover:bg-white hover:text-corporate text-base w-full sm:w-auto">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            Descargar CV
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-16 animate-fade-in-up" style="animation-delay: 400ms;">
          {stats.map((stat) => (
            <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-5 text-center border border-white/20">
              <div class="text-2xl sm:text-3xl font-bold font-mono text-intecsa-orange-light mb-1">{stat.value}</div>
              <div class="text-xs sm:text-sm text-white/80">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <BrandMarquee />

  <!-- Servicios -->
  <section id="servicios" class="py-24 relative bg-soft">
    <div class="absolute inset-0 gradient-radial-corporate"></div>
    <Container class="relative z-10">
      <AnimatedSection class="text-center max-w-3xl mx-auto mb-16">
        <p class="text-corporate font-bold text-sm uppercase tracking-widest mb-3">Nuestros servicios</p>
        <div class="corporate-line mx-auto mb-5"></div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-intecsa-gray-dark mb-6">
          Soluciones eléctricas integrales
        </h2>
        <p class="text-intecsa-slate text-lg">
          Desde el proyecto hasta la puesta en marcha, ofrecemos servicios especializados para centros comerciales, tiendas departamentales, naves industriales y edificios inteligentes.
        </p>
      </AnimatedSection>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service, index) => (
          <AnimatedSection delay={index * 100}>
            <ServiceCard {...service} />
          </AnimatedSection>
        ))}
      </div>
    </Container>
  </section>

  <!-- Certificación ABB -->
  <section class="py-20 px-4 bg-light">
    <AnimatedSection>
      <div class="max-w-5xl mx-auto rounded-3xl overflow-hidden relative bg-gradient-to-br from-gray-50 to-white border border-gray-200 shadow-xl">
        <div class="absolute top-0 right-0 w-96 h-96 bg-corporate/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
        <div class="relative z-10 grid md:grid-cols-2 gap-8 items-center p-8 md:p-12">
          <div>
            <div class="badge badge-orange mb-4">Certificación 2025</div>
            <h2 class="text-3xl md:text-4xl font-bold text-intecsa-gray-dark mb-4">
              PanelBuilder certificado por ABB
            </h2>
            <p class="text-intecsa-slate mb-6 leading-relaxed">
              El 17 de julio de 2025, <strong class="text-intecsa-gray-dark">Instalaciones y Técnica</strong> fue reconocida oficialmente como <strong class="text-intecsa-gray-dark">PanelBuilder certificado por ABB</strong>, consolidando nuestro liderazgo en soluciones de baja tensión y sistemas de integración eléctrica.
            </p>
            <a href="/certificado_abb_2025.pdf" target="_blank" class="btn-outline">
              Ver certificado oficial
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
          <div class="relative">
            <img
              src="/certificado_abb_2025_preview.jpg"
              alt="Vista previa del certificado ABB 2025"
              class="rounded-xl shadow-2xl shadow-corporate/10 w-full transform hover:scale-[1.02] transition-transform duration-500"
            />
          </div>
        </div>
      </div>
    </AnimatedSection>
  </section>

  <!-- Nuestro trabajo -->
  <section class="py-20 bg-soft">
    <Container>
      <AnimatedSection class="text-center max-w-3xl mx-auto mb-12">
        <p class="text-corporate font-bold text-sm uppercase tracking-widest mb-3">Experiencia comprobada</p>
        <div class="corporate-line mx-auto mb-5"></div>
        <h2 class="text-3xl sm:text-4xl font-bold text-intecsa-gray-dark mb-4">Nuestro trabajo</h2>
        <p class="text-intecsa-slate">Proyectos recientes para clientes líderes en retail, cines y centros comerciales.</p>
      </AnimatedSection>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <AnimatedSection delay={100}>
          <div class="group card-corporate overflow-hidden">
            <div class="relative h-56 sm:h-64 overflow-hidden">
              <img
                src="/assets/santa_anita_liverpool.webp"
                alt="Liverpool Galerías Santa Anita"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-intecsa-gray-dark/80 to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <span class="badge badge-blue">2018</span>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-intecsa-gray-dark mb-2">Liverpool Galerías Santa Anita</h3>
              <p class="text-intecsa-gray text-sm">
                Instalación eléctrica y sistemas especiales para Liverpool Santa Anita, parte de nuestros proyectos comerciales emblemáticos.
              </p>
            </div>
          </div>
        </AnimatedSection>

        <AnimatedSection delay={200}>
          <div class="group card-corporate overflow-hidden">
            <div class="relative h-56 sm:h-64 overflow-hidden">
              <img
                src="/assets/liverpool_gourmet.webp"
                alt="Liverpool Gourmet Polanco"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-intecsa-gray-dark/80 to-transparent"></div>
              <div class="absolute bottom-4 left-4">
                <span class="badge badge-blue">2024</span>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-intecsa-gray-dark mb-2">Liverpool Gourmet Polanco CDMX</h3>
              <p class="text-intecsa-gray text-sm">
                Distribuidora Liverpool: instalación eléctrica y sistemas especiales para la tienda gourmet en Polanco, Ciudad de México.
              </p>
            </div>
          </div>
        </AnimatedSection>
      </div>

      <AnimatedSection delay={300} class="text-center mt-10">
        <a href="/CV_INTECSA.pdf" target="_blank" download class="btn-outline">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Ver resumen completo de obras
        </a>
      </AnimatedSection>
    </Container>
  </section>

  <!-- Certificaciones -->
  <section class="py-20 px-4 bg-light">
    <Container>
      <AnimatedSection class="text-center max-w-3xl mx-auto mb-12">
        <p class="text-corporate font-bold text-sm uppercase tracking-widest mb-3">Calidad respaldada</p>
        <div class="corporate-line mx-auto mb-5"></div>
        <h2 class="text-3xl sm:text-4xl font-bold text-intecsa-gray-dark mb-4">Certificaciones</h2>
        <p class="text-intecsa-slate">Nuestras certificaciones y membresías avalan nuestro compromiso con la calidad y seguridad.</p>
      </AnimatedSection>

      <AnimatedSection>
        <CertsGallery>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="card-corporate p-6 text-center">
              <div class="w-16 h-16 mx-auto rounded-2xl bg-corporate/10 flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-corporate" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-intecsa-gray-dark mb-2">PanelBuilder ABB</h3>
              <p class="text-intecsa-gray text-sm">Certificación oficial como integrador de tableros de baja tensión ABB.</p>
            </div>

            <div class="card-corporate p-6 text-center">
              <div class="w-16 h-16 mx-auto rounded-2xl bg-intecsa-orange/10 flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-intecsa-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-intecsa-gray-dark mb-2">Achilles Network</h3>
              <p class="text-intecsa-gray text-sm">Membresía Silver como proveedor verificado en instalaciones eléctricas.</p>
            </div>

            <div class="card-corporate p-6 text-center">
              <div class="w-16 h-16 mx-auto rounded-2xl bg-green-500/10 flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-intecsa-gray-dark mb-2">Círculo de Proveedores</h3>
              <p class="text-intecsa-gray text-sm">Análisis de riesgo favorable con vigencia 2025-2026.</p>
            </div>
          </div>
        </CertsGallery>
      </AnimatedSection>
    </Container>
  </section>
</div>
